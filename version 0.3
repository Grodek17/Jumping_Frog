void sleep(int hundrd)
{
	clock_t start = clock();  // clock_t = clock ticks
	clock_t end = start + hundrd * CLOCKS_PER_SEC / 10;  // start + tenth * (clock per second)/10 [tenth of a second]

	while (clock() < end)
	{
		//wait...
	}
}

