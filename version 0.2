#include <curses.h>
using namespace std;

void handleWin(WINDOW* gamewin)  // not working at all...
{
	wclear(gamewin);
	mvwprintw(gamewin, 2, 2, "You won!!!! Press any key to restart :)");
	
}

void handleMove(WINDOW* gamewin, int* yPos, int* xPos, int yMax, int xMax, char frog, int* win, int * points)
{
	char move;
	move = getch();
	mvwaddch(gamewin, *yPos, *xPos, ' '); //clears current position to not leave "trace"
	if (move == 'w')
	{
		(*yPos)--;
		if (*yPos == 1)
		{
			handleWin(gamewin);
			(*win)++;
			(*points)++;
		}	
	}
	else if (move == 'a')
	{
		(*xPos)--;
		if (*xPos < 1)
		{
			*xPos = 1;
		}
	}
	else if (move == 's')
	{
		(*yPos)++;
		if (*yPos > yMax - 2)
		{
			*yPos = yMax - 2;
		}
	}
	else if (move == 'd')
	{	
		(*xPos)++;
		if (*xPos > xMax - 2)
		{
			*xPos = xMax - 2;
		}
	}
	mvwaddch(gamewin, *yPos, *xPos, frog);
	wrefresh(gamewin);
}

void initializeGame(WINDOW* gamewin, int* yPos, int* xPos, int yMax, int xMax, char frog)
{
	wclear(gamewin);
	wrefresh(gamewin);
	box(gamewin, 0, 0);
	refresh();
	wrefresh(gamewin);
	*yPos = 23;
	*xPos = 25;
	mvwprintw(gamewin, *yPos, *xPos, "F");
	mvwprintw(gamewin, 0, 2, "Zabu_the_game");
	for (int i = 1; i < xMax - 1; i++)
	{
		mvwprintw(gamewin, 1, i, "@");
	}
	wrefresh(gamewin);
	//printw("reach the water [@] to win!"); WAS DUPLIFIYING, NEED TO MOVE IT INTO DA OTHERT BOX 
}

