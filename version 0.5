void handleMove(WINDOW* gamewin, int* yPos, int* xPos, int yMax, int xMax, char frog, int* win, int* points, int * moves)
{
	char move;
	move = getch();
	mvwaddch(gamewin, *yPos, *xPos, ' '); //clears current position to not leave "trace"
	if (move == 'w')
	{
		(*moves)++;
		(*yPos)--;
		if (*yPos == 1)
		{
			handleWin(gamewin);
			(*win)++;
			(*points)++;
		}
	}
	else if (move == 'a')
	{
		(*moves)++;
		(*xPos)--;
		if (*xPos < 1)
		{
			*xPos = 1;
		}
	}
	else if (move == 's')
	{
		(*moves)++;
		(*yPos)++;
		if (*yPos > yMax - 2)
		{
			*yPos = yMax - 2;
		}
	}
	else if (move == 'd')
	{
		(*moves)++;
		(*xPos)++;
		if (*xPos > xMax - 2)
		{
			*xPos = xMax - 2;
		}
	}
	mvwaddch(gamewin, *yPos, *xPos, frog);
	wrefresh(gamewin);
}

