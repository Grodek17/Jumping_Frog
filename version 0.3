int main()
{
	// PLAYER VARIABLES   --> STRUCT
	char frog = 'F';
	int yPos = 23;
	int xPos = 25; //starting coordinates
	int yMax; //bounds
	int xMax;
	int points = 0;
	int moves = 0;
	int win = 0;
	int crash = 0;

	//CAR VARIABLES  --> STRUCT  !!!!! STRUCT
	int carY = 13;
	int carX = 48;
	char car = 'C';

	// timer?? maybe in status...
	clock_t start = clock();

	// CURSES START
	initscr();
	halfdelay(1);  // LETS CHECK IF SLEEP IS BETTER
	noecho();
	cbreak();
	curs_set(0);
	WINDOW* gamewin = newwin(25, 50, 4, 3);
	WINDOW* statbox = newwin(10, 20, 4, 60);
	getmaxyx(gamewin, yMax, xMax);
	printw("reach the water [@] to score 150 points, you lose a point every three moves!");
	refresh();
	initializeGame(gamewin, &yPos, &xPos, yMax, xMax, frog);
	initializeStats(statbox, points, moves, start);

	// MAIN GAME LOOP
	while (true)
	{
		checkColision(yPos, xPos, carY, carX, &crash);
		if (win == 1)
		{
			initializeGame(gamewin, &yPos, &xPos, yMax, xMax, frog);
			win--;
			points += 149;
			initializeStats(statbox, points, moves, start);
		}
		if (crash == 1)
		{
			initializeGame(gamewin, &yPos, &xPos, yMax, xMax, frog);
			crash--;
			points -= 299;
			initializeStats(statbox, points, moves, start);
		}
		handleMove(gamewin, &yPos, &xPos, yMax, xMax, frog, &win, &points, &moves);
		moveCar(gamewin, &carY, &carX, car, yMax, xMax);
		initializeStats(statbox, points, moves, start);
	}

	getch();
	endwin();

}
