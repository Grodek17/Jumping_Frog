void moveCar(WINDOW* gamewin, int* carY, int* carX, char car, int yMax, int xMax)
{
	sleep(1);  // can be used to manipulate speed of the car!!
	mvwaddch(gamewin, *carY, *carX, ' ');
	if (*carX == 1)
	{
		*carX = xMax - 2;
	}
	else
	{
		(*carX)--;
	}
	mvwaddch(gamewin, *carY, *carX, car);
}

