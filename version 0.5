struct CAR {
	int speed;//car sleep [speed int]
	int y;// car y
	int x;// car x
	char automobile;// [later] color
	// [later] lenght
	// [later] char
};

struct CAR CARS[8];

void moveCars(WINDOW* gamewin, int yMax, int xMax) 
{
	for (int i = 0; i < 8; i++)
	{
		//sleep(CARS[i].speed); this lags program very much
		mvwaddch(gamewin, CARS[i].y, CARS[i].x, ' ');
		if (CARS[i].x == 1)
		{
			CARS[i].x = xMax - 2;
		}
		else
		{
			CARS[i].x--;
		}
		mvwaddch(gamewin, CARS[i].y, CARS[i].x, CARS[i].automobile);
	}
}

void initializeCars()
{
	for (int i = 0; i < 8; i++)  //chwilowa zamiana na i bedace rand() % 8
	{
		CARS[i].y = (rand() % 20) + 3;
		CARS[i].x = (rand() % 20) + 3;
		CARS[i].automobile = 'A';
		CARS[i].speed = (rand() % 5) + 1;
	}
}

int main()
{
	srand(time(NULL)); // start randomizing with seed being time elapsed from 1970
	// PLAYER VARIABLES   --> STRUCT
	char frog = 'F';
	int yPos = 23;
	int xPos = 25; //starting coordinates
	int yMax; //bounds
	int xMax;
	int points = 0;
	int moves = 0;
	int win = 0;
	int crash = 0;

	//CAR VARIABLES  --> STRUCT  !!!!! STRUCT
	int carY = (rand()% 20) + 3;
	int carX = 48;
	char car = 'C';

	// timer?? maybe in status...
	clock_t start = clock();

	// CURSES START
	initscr();
	halfdelay(1);  // LETS CHECK IF SLEEP IS BETTER
	noecho();
	cbreak();
	curs_set(0);
	WINDOW* gamewin = newwin(25, 50, 4, 3);
	WINDOW* statbox = newwin(10, 20, 4, 60);
	getmaxyx(gamewin, yMax, xMax);
	printw("reach the water [@] to score 150 points, you lose a point every three moves!");
	refresh();
	initializeGame(gamewin, &yPos, &xPos, yMax, xMax, frog);
	initializeStats(statbox, points, moves, start);
	initializeCars();

	// MAIN GAME LOOP
	while (true)
	{
		checkColision(yPos, xPos, carY, carX, &crash);
		if (win == 1)
		{
			initializeGame(gamewin, &yPos, &xPos, yMax, xMax, frog);
			win--;
			points += 149;
			initializeStats(statbox, points, moves, start);
		}
		if (crash == 1)
		{
			initializeGame(gamewin, &yPos, &xPos, yMax, xMax, frog);
			crash--;
			points -= 299;
			initializeStats(statbox, points, moves, start);
		}
		handleMove(gamewin, &yPos, &xPos, yMax, xMax, frog, &win, &points, &moves);
		moveCar(gamewin, &carY, &carX, car, yMax, xMax);
		moveCars(gamewin, yMax, xMax);
		initializeStats(statbox, points, moves, start);
	}

	getch();
	endwin();

}




